{
  "name": "journey-registry",
  "sourceRoot": "apps/journey-registry/src",
  "projectType": "application",
  "tags": ["scope:platform-service", "type:service"],
  "metadata": { "owner": "Plataforma Frontend" },
  "implicitDependencies": ["platform-contracts"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "inputs": ["production", "^production", "{workspaceRoot}/journeys/**/*.json"],
      "outputs": ["{workspaceRoot}/dist/apps/journey-registry"],
      "options": {
        "main": "apps/journey-registry/src/main.ts",
        "outputPath": "dist/apps/journey-registry",
        "outputFileName": "main.js",
        "tsConfig": "apps/journey-registry/tsconfig.app.json",
        "platform": "node",
        "format": ["esm"],
        "target": "node24",
        "thirdParty": false,
        "assets": [{ "input": "journeys", "glob": "**/*.json", "output": "journeys" }]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": { "buildTarget": "journey-registry:build", "inspect": false, "watch": true }
    },
    "start": { "command": "node dist/apps/journey-registry/main.js" },
    "test": { "command": "vitest run --config apps/journey-registry/vitest.config.ts" },
    "lint": { "command": "eslint apps/journey-registry --max-warnings=0" }
  }
}
