{
  "name": "design-system-docs",
  "sourceRoot": "apps/design-system-docs/src",
  "projectType": "application",
  "tags": ["scope:design-system-docs", "type:app"],
  "implicitDependencies": ["design-system-web", "design-tokens"],
  "targets": {
