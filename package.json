{
  "name": "portal-pessoas-itau",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "golden-path": "node tools/generators/create-domain.mjs",
    "verify:federation": "node scripts/verify-federation.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "demo:portal": "nx build journey-registry && node scripts/demo-portal.mjs",
    "demo:journey-registry": "nx serve journey-registry",
    "demo:legacy": "node scripts/demo-legacy.mjs",
    "verify:external-web": "node scripts/verify-external-web.mjs",
    "verify:web-mobile-bridge": "node scripts/verify-web-mobile-bridge.mjs",
    "verify:journey-registry": "nx build journey-registry && node scripts/verify-journey-registry.mjs",
    "storybook": "nx serve design-system-docs",
    "storybook:build": "nx build design-system-docs",
    "test:design-system": "nx run-many -t test --projects=design-tokens,design-system-web,design-system-docs",
    "verify:design-system-assets": "node scripts/verify-design-system-assets.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@module-federation/runtime": "2.8.2",
    "@module-federation/vite": "1.20.7",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "6.0.5",
    "fastify": "^5.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "7.13.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nx/esbuild": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "nx": "23.1.1",
    "playwright": "^1.62.1",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "apps/portal-host/public"
    ]
  }
}
